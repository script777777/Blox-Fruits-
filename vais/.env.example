PORT=3000
SESSION_SECRET=change-me-to-a-long-random-string
# Accept verification code 123456 and print codes to the console
AUTH_DEV=1

# AI providers (at least one chat key)
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional image generation (Pollinations needs no key for basic use)
POLLINATIONS_REFERRER=vais

# Optional Turso (falls back to local SQLite file ./data/vais.db)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional email (otherwise codes are only logged)
# SMTP_URL=
# MAIL_FROM=VAIs <noreply@example.com>

# First registered email becomes admin when set
# ADMIN_EMAIL=you@example.com
