# Upstream Bypass API (serverseitig — nie VITE_ Prefix)
BYPASS_API_URL=https://deine-api.example.com/bypass
BYPASS_API_KEY=dein_api_key

# Optional:
# query | header | bearer | authorization
BYPASS_API_AUTH=query
# GET | POST
BYPASS_API_METHOD=GET
BYPASS_API_URL_PARAM=url
BYPASS_API_KEY_PARAM=api_key
BYPASS_API_PROVIDER=custom
